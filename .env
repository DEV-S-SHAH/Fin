# Local credentials for the graphrag CLI. This file is gitignored: never commit it.
# The real environment wins over anything set here, so a single run can override
# any value below without editing this file (see graphrag/envfile.py).

# NVIDIA's OpenAI-compatible gateway. Same wire protocol, different host and key,
# so the openai provider handles it via OPENAI_BASE_URL.
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

GRAPHRAG_PROVIDER=openai
GRAPHRAG_MODEL=openai/gpt-oss-20b
