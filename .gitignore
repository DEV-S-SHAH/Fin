# ── Secrets ──────────────────────────────────────────────────────────────────
# Live credentials are never committed. `.env.example` is the tracked template;
# copy it to `.env` and paste your own key. This repository is private, but git
# history is permanent: a key committed once stays readable after the file is
# deleted, so a leaked key has to be rotated, not removed.
.env
.env.*
!.env.example

# ── Build artefacts & ephemeral runs ──────────────────────────────────────────
# Transient staging parquet and scratch databases:
sandbox_engine/_run/
sandbox_engine/staging_parquet/
graph.db/
*.parquet

# Graph databases are build output, not source: `python -m sandbox_engine
# --reset` regenerates them from the committed filings in ~10s, and a binary
# graph committed here only ever disagrees with the code that built it. The
# source of truth is sandbox_engine/data/, which is tracked.
*.lbug
*.lbug/

# ── Python ───────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
