# Copy this file to `.env` and paste your own key. It is gitignored.
#
#   macOS / Linux :  cp .env.example .env
#   Windows (PS)  :  Copy-Item .env.example .env
#
# Do not commit a live key. Git history keeps it even after the file is deleted,
# so anyone with the repository could spend it, and you would have to rotate it.
#
# You do not need a key to build or verify the graph. Ingestion is pure Python
# and `python -m sandbox_engine --reset` runs the five benchmarks offline. The key
# is only for the question box in the UI.


# ── Persistent data directory ────────────────────────────────────────────────
# Single configurable directory that holds the authoritative LadybugDB, WAL,
# concept registry, Parquet staging spill, and ingestion checkpoints.
# The database is NEVER reset or recreated; it survives restarts.
# Default: ./data (relative to repository root)
# Local:   FINGRAPH_DATA_DIR=./data
# Render:  FINGRAPH_DATA_DIR=/data  (requires Persistent Disk mounted at /data)
FINGRAPH_DATA_DIR=./data


# ── Authentication ────────────────────────────────────────────────────────────
# Dev login (local only): enables "Continue locally" button on /auth page
# Set to 1 for local dev, 0 for production
FINGRAPH_DEV_LOGIN=1

# Session secret (auto-generated if not set; sessions reset on restart without it)
# Generate: openssl rand -hex 32
FINGRAPH_AUTH_SECRET=

# CORS origin (local dev uses dynamic CORS; production must set explicitly)
# Local:   http://127.0.0.1:9100
# Render:  https://your-app.onrender.com
FINGRAPH_CORS_ORIGIN=http://127.0.0.1:9100

# OAuth providers (optional - leave empty to use dev login)
# Google:   FINGRAPH_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# Apple:    FINGRAPH_APPLE_CLIENT_ID=xxx
# TradingView: FINGRAPH_TRADINGVIEW_CLIENT_ID=xxx


# ── Ports ─────────────────────────────────────────────────────────────────────
# Independent HTTP services live in this repository. All bind to loopback and
# none authenticate, so keep them that way unless you meant otherwise.
#
#   PORT_QUERY_UI     9000   python -m sandbox_engine.query_ui
#   PORT_QUERY_UI_V2  9100   python -m sandbox_engine.ui_next   (redesigned UI)
#   PORT_GRAPHRAG_UI  8765   python -m graphrag.cli serve
#
# The two explorer defaults are deliberately different so both can run at once:
# the redesigned front end serves the same graph over the same backend.
#
# An explicit `--port` flag always wins over these. A value that is not an
# integer is rejected at start-up rather than silently ignored.
# PORT_QUERY_UI=9000
# PORT_QUERY_UI_V2=9100
# PORT_GRAPHRAG_UI=8765


# ── LLM answering (sandbox_engine/query_ui.py) ──────────────────────────────

# You do not need to set a backend. The UI resolves one per request:
#   a key below            -> hosted NVIDIA model
#   no key, Ollama running -> local model
#   neither                -> the question box asks you which to use
# Set RAG_BACKEND only to override that. `ollama` forces the local model even
# when a key is present, which costs nothing and needs no network.
#   RAG_BACKEND=auto
#   RAG_BACKEND=ollama
# RAG_BACKEND=auto

# Get a key at https://build.nvidia.com. A key pasted into the browser works too
# and is held in memory only, never written here.
# Default key provided for deployment - anyone who logs in can run queries
NVIDIA_API_KEY=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

# Override only if your endpoint differs. These are the built-in defaults.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# The local backend, used when there is no key or RAG_BACKEND=ollama.
# RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# RAG_OLLAMA_MODEL=llama3.2
# RAG_NUM_CTX=16384
# RAG_TIMEOUT=900

# LLM client connect/read timeouts (seconds). Respected by all providers
# (OpenAI, NVIDIA, Gemini, Anthropic, Ollama). The read timeout applies to
# the full model call; the connect timeout is for the initial TCP/TLS handshake.
# GRAPHRAG_CONNECT_TIMEOUT=5
# GRAPHRAG_READ_TIMEOUT=60


# ── HTTP resource limits (sandbox_engine/query_ui.py) ───────────────────────
#
# Both explorers run on the stdlib ThreadingHTTPServer, which makes one thread
# per connection and sets no ceiling on how many. These bound that cost. The
# defaults are shown; you only need to set them to go beyond them.
#
# Seconds a connection may sit idle, or stall mid-request, before the handler
# closes it. Without it an idle keep-alive socket pins a thread indefinitely.
# Must exceed the slowest legitimate non-streaming response. It bounds the
# socket per read and per write, not the request as a whole, so a stream that
# keeps writing is not cut off by it.
# REQUEST_TIMEOUT=30

# Simultaneous open connections per listener. Further connections get a 503
# with a JSON body rather than a bare connection reset.
# MAX_CONNECTIONS=256

# Simultaneous SSE streams, deliberately well below MAX_CONNECTIONS. A stream
# pins its thread for as long as the model takes (RAG_TIMEOUT), so if streams
# could take the whole pool, ordinary API calls would queue behind them.
# Exceeding it returns 503 "too many concurrent streams"; retry shortly.
# MAX_SSE_CONNECTIONS=32

# Hard ceiling on one streaming response. Defaults to RAG_TIMEOUT, because that
# is the model call's own bound and nothing shorter can pre-empt a call already
# in flight. Lowering it makes a stream emit a terminal `done` with status
# "truncated" sooner.
# SSE_MAX_SECONDS=900

# Listen backlog. The stdlib default is 5, which refuses a connection burst in
# the kernel before the server can answer with a status. Measured on this repo:
# raising it from 5 to 128 cut p95 latency for 64 concurrent clients from ~120ms
# to ~4ms, because connections were otherwise being dropped and retried.
# LISTEN_BACKLOG=128

# How long a graceful drain may wait before it stops waiting and closes anyway.
# Raise only alongside your supervisor's timeout.
# SHUTDOWN_TIMEOUT=30


# ── Legacy graphrag/ package ────────────────────────────────────────────────
# Only the older `graphrag/` code reads these. The same key works for both.
# OPENAI_API_KEY=nvapi-YOUR_KEY_HERE
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# GRAPHRAG_PROVIDER=openai
# GRAPHRAG_MODEL=openai/gpt-oss-20b
