# Copy this file to `.env` and paste your own key. It is gitignored.
#
#   macOS / Linux :  cp .env.example .env
#   Windows (PS)  :  Copy-Item .env.example .env
#
# Do not commit a live key. Git history keeps it even after the file is deleted,
# so anyone with the repository could spend it, and you would have to rotate it.
#
# You do not need a key to build or verify the graph. Ingestion is pure Python
# and `python -m sandbox_engine --reset` runs the five benchmarks offline. The key
# is only for the question box in the UI.


# ── Ports ─────────────────────────────────────────────────────────────────────
# Two independent HTTP services live in this repository. Both bind to loopback
# and neither authenticates, so keep them that way unless you meant otherwise.
#
#   PORT_QUERY_UI     9000   python -m sandbox_engine.query_ui
#   PORT_GRAPHRAG_UI  8765   python -m graphrag.cli serve
#
# An explicit `--port` flag always wins over these. A value that is not an
# integer is rejected at start-up rather than silently ignored.
# PORT_QUERY_UI=9000
# PORT_GRAPHRAG_UI=8765


# ── LLM answering (sandbox_engine/query_ui.py) ──────────────────────────────

# You do not need to set a backend. The UI resolves one per request:
#   a key below            -> hosted NVIDIA model
#   no key, Ollama running -> local model
#   neither                -> the question box asks you which to use
# Set RAG_BACKEND only to override that. `ollama` forces the local model even
# when a key is present, which costs nothing and needs no network.
#   RAG_BACKEND=auto
#   RAG_BACKEND=ollama
# RAG_BACKEND=auto

# Get a key at https://build.nvidia.com. A key pasted into the browser works too
# and is held in memory only, never written here.
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# Override only if your endpoint differs. These are the built-in defaults.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# The local backend, used when there is no key or RAG_BACKEND=ollama.
# RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# RAG_OLLAMA_MODEL=llama3.2
# RAG_NUM_CTX=16384
# RAG_TIMEOUT=900


# ── Legacy graphrag/ package ────────────────────────────────────────────────
# Only the older `graphrag/` code reads these. The same key works for both.
# OPENAI_API_KEY=nvapi-YOUR_KEY_HERE
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# GRAPHRAG_PROVIDER=openai
# GRAPHRAG_MODEL=openai/gpt-oss-20b
